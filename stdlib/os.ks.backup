:: os - Operating System Interface
:: Security Hardened Version
:: Version: 2.0.0 - Added path traversal protection

let _os_safe_mode = true;
let _os_allowed_dirs = [];

:: Set safe mode (enabled by default)
func set_safe_mode(enabled) {
    _os_safe_mode = enabled;
}

:: Set allowed directories for file operations
func set_allowed_dirs(dirs) {
    _os_allowed_dirs = dirs;
}

:: Validate path against security rules
func _validate_path(path, operation) {
    if path == none || path == "" {
        raise new SecurityError;(operation + ": Path cannot be empty");
    }
    
    if _os_safe_mode {
        let normalized = path.replace("\\", "/");
        
        if normalized.starts_with("/") && !normalized.starts_with("/home/") && !normalized.starts_with("/tmp/") {
            raise new SecurityError;(operation + ": Absolute paths not allowed in safe mode");
        }
        
        if normalized.contains("../") {
            raise new SecurityError;(operation + ": Path traversal detected: " + path);
        }
        
        if _os_allowed_dirs.length > 0 {
            let is_allowed = false;
            for dir in _os_allowed_dirs {
                if normalized.starts_with(dir) {
                    is_allowed = true;
                    break;
                }
            }
            if !is_allowed {
                raise new SecurityError;(operation + ": Path not in allowed directories");
            }
        }
    }
    
    return path;
}

:: Validate path for read operations
func _validate_read_path(path) {
    return _validate_path(path, "read");
}

:: Validate path for write operations
func _validate_write_path(path) {
    return _validate_path(path, "write");
}

:: Validate path for delete operations
func _validate_delete_path(path) {
    return _validate_path(path, "delete");
}

:: Get OS name
func name() {
    return os_name();
}

:: Get environment variables
func environ() {
    return os_environ();
}

:: Get environment variable
func getenv(key, default) {
    if key == none || key == "" {
        raise new ValidationError;("Environment variable key cannot be empty");
    }
    let env = environ();
    return env[key] != none ? env[key] : default;
}

:: Set environment variable
func putenv(key, value) {
    if key == none || key == "" {
        raise new ValidationError;("Environment variable key cannot be empty");
    }
    os_putenv(key, value);
}

:: Unset environment variable
func unsetenv(key) {
    if key == none || key == "" {
        raise new ValidationError;("Environment variable key cannot be empty");
    }
    os_unsetenv(key);
}

:: Get current working directory
func getcwd() {
    return os_getcwd();
}

:: Change directory
func chdir(path) {
    if path == none || path == "" {
        raise new ValidationError;("Path cannot be empty");
    }
    let safe_path = _validate_path(path, "chdir");
    os_chdir(safe_path);
}

:: List directory contents
func listdir(path) {
    if path == none { path = "."; }
    let safe_path = _validate_read_path(path);
    return os_listdir(safe_path);
}

:: Make directory
func mkdir(path, mode) {
    if path == none || path == "" {
        raise new ValidationError;("Path cannot be empty");
    }
    let safe_path = _validate_write_path(path);
    if mode == none { mode = 0o755; }
    os_mkdir(safe_path, mode);
}

:: Make directories (recursive)
func makedirs(path, mode, exist_ok) {
    if path == none || path == "" {
        raise new ValidationError;("Path cannot be empty");
    }
    let safe_path = _validate_write_path(path);
    if mode == none { mode = 0o755; }
    if exist_ok == none { exist_ok = false; }
    
    if exists(safe_path) {
        if exist_ok { return; }
        raise new IOError;("Directory already exists: " + safe_path);
    }
    
    let parts = safe_path.split("/");
    let current = "";
    
    for part in parts {
        if part == "" { continue; }
        current = current + "/" + part;
        if !exists(current) {
            mkdir(current, mode);
        }
    }
}

:: Remove directory
func rmdir(path) {
    if path == none || path == "" {
        raise new ValidationError;("Path cannot be empty");
    }
    let safe_path = _validate_delete_path(path);
    os_rmdir(safe_path);
}

:: Remove file
func remove(path) {
    if path == none || path == "" {
        raise new ValidationError;("Path cannot be empty");
    }
    let safe_path = _validate_delete_path(path);
    
    if !exists(safe_path) {
        raise new IOError;("File does not exist: " + safe_path);
    }
    
    os_remove(safe_path);
}

:: Rename file/directory
func rename(src, dst) {
    if src == none || src == "" {
        raise new ValidationError;("Source path cannot be empty");
    }
    if dst == none || dst == "" {
        raise new ValidationError;("Destination path cannot be empty");
    }
    let safe_src = _validate_write_path(src);
    let safe_dst = _validate_write_path(dst);
    os_rename(safe_src, safe_dst);
}

:: Get file stats
func stat(path) {
    if path == none || path == "" {
        raise new ValidationError;("Path cannot be empty");
    }
    let safe_path = _validate_read_path(path);
    return os_stat(safe_path);
}

:: Get file stats (without following symlinks)
func lstat(path) {
    if path == none || path == "" {
        raise new ValidationError;("Path cannot be empty");
    }
    let safe_path = _validate_read_path(path);
    return os_lstat(safe_path);
}

:: Change file permissions
func chmod(path, mode) {
    if path == none || path == "" {
        raise new ValidationError;("Path cannot be empty");
    }
    let safe_path = _validate_write_path(path);
    os_chmod(safe_path, mode);
}

:: Change file owner
func chown(path, uid, gid) {
    if path == none || path == "" {
        raise new ValidationError;("Path cannot be empty");
    }
    let safe_path = _validate_write_path(path);
    os_chown(safe_path, uid, gid);
}

:: Create hard link
func link(src, dst) {
    if src == none || src == "" {
        raise new ValidationError;("Source path cannot be empty");
    }
    if dst == none || dst == "" {
        raise new ValidationError;("Destination path cannot be empty");
    }
    let safe_src = _validate_read_path(src);
    let safe_dst = _validate_write_path(dst);
    os_link(safe_src, safe_dst);
}

:: Create symbolic link
func symlink(src, dst) {
    if src == none || src == "" {
        raise new ValidationError;("Source path cannot be empty");
    }
    if dst == none || dst == "" {
        raise new ValidationError;("Destination path cannot be empty");
    }
    let safe_src = _validate_read_path(src);
    let safe_dst = _validate_write_path(dst);
    os_symlink(safe_src, safe_dst);
}

:: Read symbolic link
func readlink(path) {
    if path == none || path == "" {
        raise new ValidationError;("Path cannot be empty");
    }
    let safe_path = _validate_read_path(path);
    return os_readlink(safe_path);
}

:: Check if path exists
func exists(path) {
    if path == none || path == "" {
        return false;
    }
    let safe_path = _validate_read_path(path);
    return os_exists(safe_path);
}

:: Check if path is a file
func isfile(path) {
    if path == none || path == "" {
        return false;
    }
    let safe_path = _validate_read_path(path);
    return os_isfile(safe_path);
}

:: Check if path is a directory
func isdir(path) {
    if path == none || path == "" {
        return false;
    }
    let safe_path = _validate_read_path(path);
    return os_isdir(safe_path);
}

:: Check if path is a symbolic link
func islink(path) {
    if path == none || path == "" {
        return false;
    }
    let safe_path = _validate_read_path(path);
    return os_islink(safe_path);
}

:: Get process ID
func getpid() {
    return os_getpid();
}

:: Get parent process ID
func getppid() {
    return os_getppid();
}

:: Get user ID
func getuid() {
    return os_getuid();
}

:: Get group ID
func getgid() {
    return os_getgid();
}

:: Send signal to process
func kill(pid, signal) {
    if pid == none || pid <= 0 {
        raise new ValidationError;("Invalid process ID");
    }
    if signal == none { signal = 15; }
    os_kill(pid, signal);
}

:: Execute system command (SECURED)
func system(command) {
    if command == none || command == "" {
        raise new ValidationError;("Command cannot be empty");
    }
    
    if _os_safe_mode {
        if command.contains(";") || command.contains("&&") || command.contains("||") {
            raise new SecurityError;("Potential command injection detected");
        }
        if command.contains("|") || command.contains("`") {
            raise new SecurityError;("Potential command injection detected");
        }
        if command.contains("$(") || command.contains("${") {
            raise new SecurityError;("Potential command injection detected");
        }
    }
    
    return os_system(command);
}

:: Open pipe (SECURED)
func popen(command, mode) {
    if command == none || command == "" {
        raise new ValidationError;("Command cannot be empty");
    }
    
    if _os_safe_mode {
        if command.contains(";") || command.contains("&&") || command.contains("||") {
            raise new SecurityError;("Potential command injection detected");
        }
    }
    
    if mode == none { mode = "r"; }
    return os_popen(command, mode);
}

:: Walk directory tree (SECURED)
func walk(top, visited) {
    if top == none || top == "" {
        raise new ValidationError;("Path cannot be empty");
    }
    let safe_top = _validate_read_path(top);
    
    if visited == none { visited = {}; }
    
    if visited[safe_top] {
        return [];
    }
    visited[safe_top] = true;
    
    let dirs = [];
    let files = [];
    
    for entry in listdir(safe_top) {
        let path = safe_top + "/" + entry;
        if isdir(path) {
            dirs.push(entry);
        } else {
            files.push(entry);
        }
    }
    
    let result = [[safe_top, dirs, files]];
    
    for dir in dirs {
        let subpath = safe_top + "/" + dir;
        let sub_result = walk(subpath, visited);
        for item in sub_result {
            result.push(item);
        }
    }
    
    return result;
}

:: Runtime interface (these are provided by the runtime)
func os_name() { return "posix"; }
func os_environ() { return {"PATH": "/usr/bin", "HOME": "/home/user"}; }
func os_putenv(key, value) { }
func os_unsetenv(key) { }
func os_getcwd() { return "/home/user"; }
func os_chdir(path) { }
func os_listdir(path) { return ["file1.txt", "file2.txt"]; }
func os_mkdir(path, mode) { }
func os_rmdir(path) { }
func os_remove(path) { }
func os_rename(src, dst) { }
func os_stat(path) { return {"size": 1024, "mtime": 1709640000}; }
func os_lstat(path) { return os_stat(path); }
func os_chmod(path, mode) { }
func os_chown(path, uid, gid) { }
func os_link(src, dst) { }
func os_symlink(src, dst) { }
func os_readlink(path) { return path; }
func os_exists(path) { return true; }
func os_isfile(path) { return true; }
func os_isdir(path) { return false; }
func os_islink(path) { return false; }
func os_getpid() { return 1234; }
func os_getppid() { return 1; }
func os_getuid() { return 1000; }
func os_getgid() { return 1000; }
func os_kill(pid, signal) { }
func os_system(command) { return 0; }
func os_popen(command, mode) { return none; }

:: Error classes
class SecurityError {
    func __init__(self, message) {
        self.message = message;
    }
    func to_string() {
        return "SecurityError: " + self.message;
    }
}

class IOError {
    func __init__(self, message) {
        self.message = message;
    }
    func to_string() {
        return "IOError: " + self.message;
    }
}

class ValidationError {
    func __init__(self, message) {
        self.message = message;
    }
    func to_string() {
        return "ValidationError: " + self.message;
    }
}

export {
    :: Core functions
    name, environ, getenv, putenv, unsetenv,
    getcwd, chdir, listdir, mkdir, makedirs, rmdir,
    remove, rename, stat, lstat, chmod, chown,
    link, symlink, readlink,
    exists, isfile, isdir, islink,
    getpid, getppid, getuid, getgid, kill,
    system, popen, walk,
    
    :: Security functions
    set_safe_mode, set_allowed_dirs,
    
    :: Error classes
    SecurityError, IOError, ValidationError
};

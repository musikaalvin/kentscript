struct Student {let name[30]; float marks;}

struct Student s1;

print(input("Enter ID: %d", s1.id));
print(input("Enter Name:%s", s1.name));
print(input("Enter Marks: %f", s1.marks));

print("\nStudent Information\n");
print("ID: %d\n", s1.id);
print("Name: %s\n", s1.name);
print("Marks: %.2f\n", s1.marks);
{
  "name": "KentScript",
  "scopeName": "source.kentscript",
  "fileTypes": [
    "ks"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#unsafe_operations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-colon.kentscript",
          "match": "::.*$"
        },
        {
          "name": "comment.line.double-slash.kentscript",
          "match": "//.*$"
        },
        {
          "name": "comment.block.kentscript",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.unsafe.kentscript",
          "match": "\\b(unsafe)\\b"
        },
        {
          "name": "keyword.control.kentscript",
          "match": "\\b(if|else|elif|while|for|in|break|continue|return|match|case|default|try|catch|finally|throw|raise|do|switch|goto)\\b"
        },
        {
          "name": "keyword.declaration.kentscript",
          "match": "\\b(let|const|mut|func|genfunc|class|struct|enum|union|import|from|export|type|interface)\\b"
        },
        {
          "name": "keyword.other.kentscript",
          "match": "\\b(unsafe|safe|async|await|yield|new|delete|del|sizeof|typeof|as|with|pass|global|nonlocal|borrow|release|move|asm|lambda|thread|assert)\\b"
        },
        {
          "name": "constant.language.kentscript",
          "match": "\\b(true|false|null|none|undefined|self|super|cls|pub|priv)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.kentscript",
          "match": "\\b(int|uint|i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|float|f32|f64|bool|str|string|char|void|any|ptr)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.kentscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.kentscript",
              "match": "\\\\."
            },
            {
              "name": "constant.other.placeholder.kentscript",
              "match": "\\{[^}]*\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.kentscript",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.kentscript",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.interpolated.kentscript",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "meta.embedded.kentscript",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.kentscript",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.kentscript",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.kentscript",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.decimal.kentscript",
          "match": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.kentscript",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        },
        {
          "name": "support.function.builtin.kentscript",
          "match": "\\b(print|println|len|type|range|malloc|free|asm|rdtsc|cpuid|ptr_read|ptr_write|atomic_load|atomic_store)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.kentscript",
          "match": "(\\+|\\-|\\*|/|%|==|!=|<|>|<=|>=|&&|\\|\\||!|&|\\||\\^|<<|>>|=|\\+=|\\-=|\\*=|/=)"
        }
      ]
    },
    "unsafe_operations": {
      "patterns": [
        {
          "name": "support.function.unsafe.kentscript",
          "match": "\\b(malloc|free|mmap|munmap|ptr_read|ptr_write|ptr_cast|asm|rdtsc|cpuid|atomic_load|atomic_store|atomic_add|atomic_cas|volatile_read|volatile_write|memory_barrier|compiler_barrier|cache_flush|cache_invalidate|mmio_read|mmio_write|read_port|write_port|syscall_raw)\\b"
        },
        {
          "name": "variable.language.unsafe.kentscript",
          "match": "\\b(io|msr)\\s*\\["
        }
      ]
    }
  }
}
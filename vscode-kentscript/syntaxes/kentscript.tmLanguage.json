{
  "name": "KentScript",
  "scopeName": "source.kentscript",
  "fileTypes": [
    "ks"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#unsafe_operations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-colon.kentscript",
          "match": "::.*$"
        },
        {
          "name": "comment.line.triple-slash.kentscript",
          "match": "///.*$"
        },
        {
          "name": "comment.block.kentscript",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kentscript",
          "match": "\\b(await|break|case|catch|continue|default|do|elif|else|except|finally|for|if|in|match|raise|return|switch|to|try|while|yield)\\b"
        },
        {
          "name": "keyword.declaration.kentscript",
          "match": "\\b(async|class|const|enum|export|extends|from|func|implements|import|interface|lambda|let|module|mut|new|struct|type|union)\\b"
        },
        {
          "name": "keyword.modifier.kentscript",
          "match": "\\b(as|borrow|move|release|safe|static|unsafe|volatile)\\b"
        },
        {
          "name": "keyword.other.kentscript",
          "match": "\\b(and|asm|assert|del|false|global|goto|impl|inline|none|nonlocal|not|or|pass|self|sizeof|super|trait|true|with)\\b"
        },
        {
          "name": "constant.language.kentscript",
          "match": "\\b(false|inf|nan|none|null|true|undefined)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.kentscript",
          "match": "\\b(any|bool|char|f128|f16|f32|f64|float|i128|i16|i32|i64|i8|int|isize|ptr|str|string|u128|u16|u32|u64|u8|uint|usize|void)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.kentscript",
          "match": "\\b(abs|acos|all|alloca|any|append|asin|assert|atan|atan2|atomic_add|atomic_cas|atomic_sub|atomic_swap|bin|bool|borrow|call_ptr|calloc|cbrt|ceil|channel|char|chr|clamp|cli|close|contains|copy|cos|cpuid|decrypt|dict|dma_transfer|encrypt|endswith|enumerate|env|exit|exp|ffi_call|ffi_load|filter|float|floor|format|format_value|free|getcwd|getenv|hash|hex|hlt|hypot|inb|input|int|inw|items|join|keys|len|list|lock|log|log10|log2|lower|makedirs|malloc|map|max|memcpy|memset|min|mmap|mprotect|munmap|oct|open|ord|outb|outw|panic|pause|pop|pow|print|println|ptr|ptr_read|ptr_write|push|random|range|rdtsc|read|read_byte|read_file|read_string|read_word|realloc|recv|reduce|release|remove|rename|replace|reverse|reversed|round|seek|send|sign|sin|sleep|sort|sorted|spawn|spawn_thread|split|sqrt|startswith|stat|sti|str|sum|syscall|system|tan|tell|ternary|trim|type_of|unlock|unwrap|upper|uuid|values|write|write_byte|write_file|write_string|write_word|zip)\\b"
        }
      ]
    },
    "unsafe_operations": {
      "patterns": [
        {
          "name": "support.function.unsafe.kentscript",
          "match": "\\b(malloc|free|mmap|munmap|ptr_read|ptr_write|ptr_cast|asm|rdtsc|cpuid|cli|sti|hlt|pause|atomic_load|atomic_store|atomic_add|atomic_cas|atomic_swap|volatile_read|volatile_write|memory_barrier|dmb|dsb|isb|mmio_read|mmio_write|read_port|write_port|memcpy|memset|memmove|alloca|dma_transfer|call_ptr)\\b"
        },
        {
          "name": "variable.language.unsafe.kentscript",
          "match": "\\b(io|msr)\\s*\\["
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.kentscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.kentscript",
              "match": "\\\\."
            },
            {
              "name": "constant.other.placeholder.kentscript",
              "match": "\\{[^}]*\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.kentscript",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.kentscript",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.interpolated.kentscript",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "meta.embedded.kentscript",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.kentscript",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.kentscript",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.kentscript",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.decimal.kentscript",
          "match": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.kentscript",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.kentscript",
          "match": "(\\+|\\-|\\*|/|%|==|!=|<|>|<=|>=|&&|\\|\\||!|&|\\||\\^|<<|>>|=|\\+=|\\-=|\\*=|/=|->|=>|\\.\\.|\\?)"
        }
      ]
    }
  }
}